# Copia este archivo como ".env.local" y coloca ahí tus claves reales.
# ".env.local" NUNCA se sube a GitHub (ver .gitignore) — solo vive en tu computadora y en Vercel.

# Clave de la API de Gemini (Google AI Studio -> https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Claves de Supabase (Project Settings -> API en tu proyecto de Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave SECRETA de Supabase. EXCLUSIVAMENTE DE SERVIDOR.
#
# Sin el prefijo NEXT_PUBLIC_ a proposito: Next.js solo incluye en el
# bundle del navegador las variables que lo llevan, asi que esta no puede
# llegar al cliente. Nunca se la anadas.
#
# Se usa en UN solo lugar (src/lib/supabase/servidorPrivilegiado.ts) y
# para UNA sola llamada: conservar el analisis del ciclo adaptativo. La
# RPC guardar_analisis_adaptativo() no esta concedida a anon ni a
# authenticated, de modo que el navegador no puede escribir un analisis
# aunque lo intente desde la consola.
#
# Todo lo demas de la aplicacion sigue usando la clave publicable de
# arriba, con las policies RLS como autorizacion real.
#
# Mientras esta variable este vacia, el ciclo funciona y lo declara: el
# intento se registra, Gemini analiza, y la interfaz avisa de que el
# analisis todavia no se conserva.
SUPABASE_SECRET_KEY=
